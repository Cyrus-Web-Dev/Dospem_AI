DATABASE_URL=postgresql+psycopg://dospem:dospem@localhost:5433/dospem
# Tanpa Docker: DATABASE_URL=sqlite:///./dospem.db
SECRET_KEY=ganti-dengan-string-acak-panjang   # python -c "import secrets;print(secrets.token_urlsafe(48))"
CONTACT_EMAIL=kamu@example.com                # dipakai OpenAlex/Crossref (polite pool)
LLM_PROVIDER=mock            # mock | openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
FREE_DAILY_QUOTA=5
PREMIUM_DAILY_QUOTA=50
MAX_CHARS_PER_REQUEST=3000

# Admin & pembayaran
ADMIN_EMAILS=kamu@example.com          # pisahkan dengan koma
BASE_URL=http://127.0.0.1:8000         # URL publik (untuk redirect setelah bayar)
PAYMENT_PROVIDER=mock                  # mock | midtrans | xendit
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Produksi & kuota
ENV=dev                      # dev | prod (prod menolak konfigurasi tidak aman)
REDIS_URL=                   # contoh dev: redis://localhost:6379/0 ; kosong = kuota di database
PREMIUM_ANALYSIS_QUOTA=10
RATE_LIMIT_ENABLED=true      # matikan hanya untuk pengujian otomatis

# --- Sumber contoh tambahan (opsional) ---
# DOAJ, OpenAlex, Crossref aktif otomatis. Dua sumber di bawah NONAKTIF sampai kamu memastikan ketentuan layanannya
# mengizinkan pemakaian di produk berbayar (Semantic Scholar: lisensi komersial dari AI2; CORE: lihat core.ac.uk/terms).
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=
CORE_ENABLED=false
CORE_API_KEY=
# Basis tautan "Cari juga di" (jika alamat resmi berubah)
SINTA_BASE=https://sinta.kemdiktisaintek.go.id
GARUDA_BASE=https://garuda.kemdiktisaintek.go.id

# --- Mode Sidang (Premium) ---
PREMIUM_SIDANG_QUOTA=40        # langkah per hari: 1 untuk mulai + 1 per jawaban
SIDANG_DEFAULT_QUESTIONS=6
SIDANG_ANSWER_CHARS=3000

# --- Tahap 6: kesiapan draf, riwayat versi ---
READY_MIN_WORDS=150              # ambang "layak kirim" bila gaya selingkung tidak menetapkan min_words
READY_MAX_ISSUES_PER_100W=8
REVISION_MIN_MINUTES=5           # jeda minimal antar snapshot revisi (0 = setiap perubahan)
REVISION_KEEP=15                 # snapshot terbaru yang disimpan per draf

# --- Tahap 8: keamanan akun, hak data, syarat & privasi ---
LOGIN_MAX_FAILURES=5             # gagal masuk berturut-turut sebelum akun dikunci sementara
LOGIN_LOCK_MINUTES=15
REQUIRE_TERMS_CONSENT=false      # true di produksi publik: pendaftaran wajib menyetujui Syarat & Privasi
TERMS_VERSION=2026-11            # naikkan saat isi static/legal.html berubah bermakna
ACCESS_LOG_DAYS=365              # lama riwayat akses dosen ke draf disimpan

# --- Email (reset kata sandi) ---
# mock = tidak kirim apa pun; tautan reset muncul di log server (hanya pengembangan)
# gmail = Gmail API (OAuth2). Lihat scripts/get_gmail_token.py untuk mendapatkan refresh token.
EMAIL_PROVIDER=mock
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=                    # contoh: Dospem <akun-anda@gmail.com>
RESET_TOKEN_MINUTES=30
RESET_MAX_PER_HOUR=3             # permintaan reset per akun per jam

# --- Kontrol biaya LLM ---
LLM_DAILY_TOKEN_BUDGET=0         # pagar harian total token (masuk+keluar) untuk SEMUA pengguna; 0 = tanpa batas. WAJIB diisi di produksi
LLM_MAX_TOKENS_COACH=900         # batas panjang jawaban per jenis panggilan
LLM_MAX_TOKENS_ANALYZE=1600
LLM_MAX_TOKENS_SIDANG=800
LLM_MAX_TOKENS_SUMMARY=1400
LLM_TOKEN_PARAM=max_tokens       # atau max_completion_tokens untuk model yang mewajibkannya
LLM_PRICE_IN_PER_MTOK=0          # harga per 1 juta token (hanya untuk estimasi biaya di dasbor admin)
LLM_PRICE_OUT_PER_MTOK=0
LLM_COST_CURRENCY=USD
LLM_CACHE_DAYS=7                 # 0 = cache hasil dimatikan
LLM_CACHE_MAX_PER_OWNER=100

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=                      # json | text; kosong = json di produksi, text di pengembangan
SLOW_REQUEST_MS=2000             # permintaan lebih lambat dicatat sebagai WARNING
SENTRY_DSN=                      # kosong = Sentry mati. Event disaring ketat (tanpa isi permintaan/header/cookie/query/pengguna/variabel lokal)
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=                     # mis. git sha, agar error bisa dikaitkan ke versi
