DOMAIN=dospem.contoh.id
POSTGRES_PASSWORD=ganti-password-db
ENV=prod
BASE_URL=https://dospem.contoh.id
DATABASE_URL=postgresql+psycopg://dospem:ganti-password-db@db:5432/dospem
REDIS_URL=redis://redis:6379/0
SECRET_KEY=                      # python -c "import secrets;print(secrets.token_urlsafe(48))"
CONTACT_EMAIL=kamu@contoh.id
ADMIN_EMAILS=kamu@contoh.id
PAYMENT_PROVIDER=midtrans        # atau xendit; JANGAN mock
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
SENTRY_DSN=                      # disarankan: pemantauan error produksi (lihat bagian Observability di README)
APP_RELEASE=
LOG_FORMAT=json
LLM_DAILY_TOKEN_BUDGET=2000000      # WAJIB: pagar biaya harian (token). Sesuaikan dengan anggaranmu; 0 = tanpa batas (server akan memberi peringatan)
LLM_PRICE_IN_PER_MTOK=           # isi harga model agar dasbor admin menampilkan estimasi biaya
LLM_PRICE_OUT_PER_MTOK=
REQUIRE_TERMS_CONSENT=true       # wajib untuk rilis publik; lengkapi juga static/legal.html
EMAIL_PROVIDER=gmail             # wajib di produksi (server menolak mulai bila masih mock)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=Dospem <akun-anda@gmail.com>
